# Database — use the docker-compose Postgres, or your own
DATABASE_URL=postgresql://smdev:smdev@localhost:5432/smdev

# Auth secret — MUST be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Base URL for auth callbacks/redirects
BETTER_AUTH_URL=http://localhost:3000

# First user to sign up with this email gets system_admin role
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# External API tokens (optional — app works without these, just no live data)
# META_ACCESS_TOKEN=
# APIFY_API_TOKEN=
# TIKTOK_RESEARCH_CLIENT_KEY=
# TIKTOK_RESEARCH_CLIENT_SECRET=
